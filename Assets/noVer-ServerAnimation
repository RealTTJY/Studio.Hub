H.Heartbeat:Connect(function(dt)
	if Components.hoverState and Configs.HoverSpin and Components.hoverState.clone.Parent then
		Components.hoverState.angle = Components.hoverState.angle + dt * 1.8;
		Components.hoverState.clone:PivotTo(CFrame.Angles(0, Components.hoverState.angle, 0));
	end;
end);
Components.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	Library.currentPage = 1;
	Functions.applyFilter();
end);
Components.prevBtn.Activated:Connect(function()
	if Library.currentPage > 1 then
		Library.currentPage = Library.currentPage - 1;
		Functions.updatePageBar();
		Functions.renderCards();
	end;
end);
Components.nextBtn.Activated:Connect(function()
	if Library.currentPage < Functions.totalPages() then
		Library.currentPage = Library.currentPage + 1;
		Functions.updatePageBar();
		Functions.renderCards();
	end;
end);
UIS.InputBegan:Connect(function(input, gp)
	if Components.listening then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			Components.listening = false;
			if input.KeyCode ~= Enum.KeyCode.Escape then
				Configs.Keybind = input.KeyCode;
				Functions.toast("Keybind set to " .. input.KeyCode.Name);
			end;
			Components.keyBtn.Text = Configs.Keybind.Name;
		end;
		return;
	end;
	if gp or UIS:GetFocusedTextBox() then return; end;
	if input.KeyCode == Configs.Keybind then Functions.setOpen(not Library.open); end;
end);
Functions.onChar = function(char)
	selc = char;
	Library.current = nil;
	local hum = WaitForChild(char, "Humanoid", 10);
	if not hum then return; end;
	HumSelf = hum;
	HumRSelf = hum.RootPart or EMPTY_OBJECT;
	hum.Running:Connect(function(spd)
		if Configs.StopOnMove and spd > 0.5 and Library.current then Functions.stopCurrent(); end;
	end);
	if Library.equipped then
		tspawn(function()
			Functions.setBundle(char, Library.equipped);
			Functions.refreshState();
		end);
	end;
	twait(0.5);
	Functions.refreshState();
	if Library.open and LIB[Library.activeTab] then Functions.applyFilter(); end;
end;
selff.CharacterAdded:Connect(Functions.onChar);
if selff.Character then tspawn(Functions.onChar, selff.Character); end;
Components.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() Functions.layout(); end);
Functions.layout();
Functions.showTab("Emotes");
