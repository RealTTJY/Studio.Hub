Functions.buildPreview = function(vp, item)
	vp:ClearAllChildren();
	local char = selff.Character;
	if not char then return; end;
	char.Archivable = true;
	local ok, clone = pcall(function() return char:Clone(); end);
	if not ok or not clone then return; end;
	for _, d in ipairs(clone:GetDescendants()) do
		if IsA(d, "BaseScript") then d:Destroy(); end;
	end;
	local root_ = FindFirstChild(clone, "HumanoidRootPart");
	local hum = FindFirstChildOfClass(clone, "Humanoid");
	if not root_ or not hum then clone:Destroy(); return; end;
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None;
	if Configs.PreviewMode == "Silhouette" then Functions.makeSilhouette(clone); end;
	local wm = Library.new("WorldModel", {Parent = vp});
	clone.Parent = wm;
	clone:PivotTo(CFr(0, 0, 0));
	root_.Anchored = true;
	local cam = Library.new("Camera", {FieldOfView = 45; Parent = vp;});
	cam.CFrame = CFrame.lookAt(Vec3(0, 0.1, -8.6), Vec3(0, -0.15, 0));
	vp.CurrentCamera = cam;
	Components.previews[vp] = {clone = clone; angle = 0;};
	pcall(function()
		local animator = FindFirstChildOfClass(hum, "Animator") or Instancen("Animator", hum);
		local anim = Instancen("Animation");
		anim.AnimationId = Functions.normId(Functions.previewAnimId(item));
		local track = animator:LoadAnimation(anim);
		track.Looped = true;
		track:Play();
	end);
end;
