Functions.applyFilter = function()
	if not LIB[Library.activeTab] then return; end;
	local raw = {};
	for idx, item in ipairs(LIB[Library.activeTab]) do
		tblein(raw, {item = item; i = idx;});
	end;
	tblesort(raw, function(x, y)
		local s = Configs.Sort;
		if s == "Name (A-Z)" then
			local nx, ny = x.item.N or x.item.Name, y.item.N or y.item.Name;
			if nx ~= ny then return nx < ny; end;
		elseif s == "Free first" then
			local fx, fy = Functions.isFree(x.item), Functions.isFree(y.item);
			if fx ~= fy then return fx; end;
		elseif s == "Price: Low to High" then
			local px, py = Functions.price(x.item), Functions.price(y.item);
			if px ~= py then return px < py; end;
		end;
		return x.i < y.i;
	end);
	Library.filteredList = {};
	for _, e in ipairs(raw) do
		if Functions.passes(e.item) then tblein(Library.filteredList, e); end;
	end;
	Library.currentPage = math.clamp(Library.currentPage, 1, Functions.totalPages());
	Functions.updatePageBar();
	Functions.renderCards();
end;
Functions.renderCards = function()
	if not LIB[Library.activeTab] then return; end;
	Library.renderToken = Library.renderToken + 1;
	local token = Library.renderToken;
	for _, ch in ipairs(Components.lib:GetChildren()) do
		if IsA(ch, "Frame") then ch:Destroy(); end;
	end;
	tbleclr(Library.cards);
	Components.hoverState = nil;
	Components.lib.CanvasPosition = Vec2(0, 0);
	Functions.updateGrid();
	local startI = (Library.currentPage - 1) * Library.PAGE_SIZE + 1;
	local endI   = math.min(startI + Library.PAGE_SIZE - 1, #Library.filteredList);
	local empty = #Library.filteredList == 0;
	Components.emptyLabel.Visible = empty;
	if empty then
		Components.emptyLabel.Text = Library.favOnly and next(Library.favs) == nil
			and "No favorites yet.\nTap ★ on a card to pin it."
			or "Nothing found.";
		return;
	end;
	local pending = {};
	for order = startI, endI do
		local e = Library.filteredList[order];
		local entry = Functions.makeCard(e.item, order - startI + 1);
		if entry.vp then tblein(pending, entry); end;
	end;
	Functions.refreshState();
	tspawn(function()
		for _, e in ipairs(pending) do
			if token ~= Library.renderToken or not Library.open then return; end;
			pcall(Functions.buildPreview, e.vp, e.item);
			twait();
		end;
	end);
end;
Functions.refreshState = function()
