Functions.stopCurrent = function()
	local current = Library.current;
	if current then
		local trk = current.track;
		pcall(function() trk:Stop(0.15); end);
		tdelay(0.2, function() pcall(function() trk:Destroy(); end); end);
		Library.current = nil;
	end;
	if Functions.refreshState then Functions.refreshState(); end;
end;
Functions.useEmote = function(self, item)
	local current = Library.current;
	local itemName = item.N or item.Name;
	if current and (current.item == item or (current.item.N or current.item.Name) == itemName) then
		return self.stopCurrent();
	end;
	self.stopCurrent();
	local Animator = self.getAnimator();
	if not Animator then return; end;
	local Anim = Instancen("Animation");
	Anim.AnimationId = self.normId(item.A or item.Anim);
	local ok, track = pcall(function() return Animator:LoadAnimation(Anim); end);
	if not ok or not track then return self.toast("Couldn't load " .. itemName); end;
	track.Priority = Enum.AnimationPriority.Action4;
	track.Looped = item.Loop ~= false;
	track:Play(0.2);
	track:AdjustSpeed(Library.speed);
	Library.current = {item = item; track = track;};
	track.Stopped:Connect(function()
		if Library.current and Library.current.track == track then
			Library.current = nil;
			self.refreshState();
		end;
	end);
	self.refreshState();
	self.toast("Playing  " .. itemName);
end;
Functions.findAnim = function(animate, path)
	local o = animate;
	for _, name in ipairs(path) do o = o and FindFirstChild(o, name); end;
	return (o and IsA(o, "Animation")) and o or nil;
end;
Functions.cacheDefaults = function(char, animate)
	local defs = Library.defaultAnimIds[char];
	if defs then return defs; end;
	defs = {};
	for key, path in pairs(KEYPATH) do
		local anim = Functions.findAnim(animate, path);
		if anim and IsA(anim, "Animation") and anim.AnimationId ~= "" then
			defs[key] = anim.AnimationId;
		end;
	end;
	if next(defs) then Library.defaultAnimIds[char] = defs; end;
	return defs;
end;
Functions.stopAllTracks = function(char)
	if Library.current then
		local trk = Library.current.track;
		pcall(function() trk:Stop(0); trk:Destroy(); end);
		Library.current = nil;
	end;
	local hum = char and FindFirstChildOfClass(char, "Humanoid");
	local animator = hum and FindFirstChildOfClass(hum, "Animator");
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			pcall(function() track:Stop(0); track:Destroy(); end);
		end;
	end;
	if hum then
		pcall(function()
			for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
				pcall(function() track:Stop(0); track:Destroy(); end);
			end;
		end);
	end;
end;
Functions.restartAnimate = function(char, animate)
	local hum = char and FindFirstChildOfClass(char, "Humanoid");
	if not hum then return; end;
	Functions.stopAllTracks(char);
	pcall(function()
		local env = getsenv(animate);
		if type(env) == "table" and type(env.stopAllAnimations) == "function" then
			env.stopAllAnimations();
		end;
	end);
	if hum.Health > 0 then
		local prevState = hum:GetState();
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.PlatformStanding); end);
		twait(0.22);
		pcall(function()
			local resumeState = prevState == Enum.HumanoidStateType.PlatformStanding and Enum.HumanoidStateType.Running or prevState;
			hum:ChangeState(resumeState);
		end);
	end;
end;
Functions.setBundle = function(char, bundle)
	local animate = FindFirstChild(char, "Animate") or WaitForChild(char, "Animate", 8);
	if not animate then return false; end;
	Functions.stopCurrent();
	local defs = Functions.cacheDefaults(char, animate);
	for key, path in pairs(KEYPATH) do
		local anim = Functions.findAnim(animate, path);
		if anim and defs[key] then anim.AnimationId = defs[key]; end;
	end;
	local anims = bundle and (bundle.A or bundle.Anims);
	if bundle and anims then
		for key, id in pairs(anims) do
			if id then
				local path = KEYPATH[key];
				local anim = path and Functions.findAnim(animate, path);
				if anim then anim.AnimationId = Functions.normId(id); end;
			end;
		end;
		if anims.Idle1 and not anims.Idle3 then
			local anim3 = Functions.findAnim(animate, KEYPATH.Idle3);
			if anim3 then anim3.AnimationId = Functions.normId(anims.Idle1); end;
		end;
	end;
	Functions.restartAnimate(char, animate);
	return true;
end;
