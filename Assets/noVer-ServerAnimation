		local active = Functions.isActive(c.item);
		c.btn.Text = active and (c.kind == "bundle" and "REMOVE" or "STOP") or "USE";
		Tween(c.btn, {BackgroundColor3 = active and COLORS.accent or COLORS.black; BackgroundTransparency = active and 0.1 or 0.35;}, 0.15);
		Tween(c.st, {Color = active and COLORS.accent or CARD_LINE; Transparency = active and 0.05 or 0.62;}, 0.2);
	end;
	local current = Library.current;
	if current then
		Components.pillName.Text = current.item.N or current.item.Name;
		Tween(Components.pill, {Position = Components.PILL_SHOWN}, 0.45, Enum.EasingStyle.Back);
	else
		Tween(Components.pill, {Position = Components.PILL_HIDDEN}, 0.3);
	end;
	if Components.mixPlaying then Components.mixPlaying.Text = current and (current.item.N or current.item.Name) or "Nothing"; end;
