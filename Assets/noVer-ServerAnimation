		set(o.min + math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) * (o.max - o.min));
	end;
	local dragging, scroller = false, nil;
	hit.InputBegan:Connect(function(i)
		if Library.isPress(i) then
			dragging = true;
			scroller = hit:FindFirstAncestorWhichIsA("ScrollingFrame");
			if scroller then scroller.ScrollingEnabled = false; end;
			fromX(i.Position.X);
		end;
	end);
	UIS.InputChanged:Connect(function(i) if dragging and Library.isMove(i) then fromX(i.Position.X); end; end);
	UIS.InputEnded:Connect(function(i)
		if dragging and Library.isPress(i) then
			dragging = false;
			if scroller then scroller.ScrollingEnabled = true; end;
		end;
	end);
	set(o.default, true);
	return {frame = f; set = set;};
end;
